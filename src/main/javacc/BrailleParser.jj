options {
  STATIC = false;
  UNICODE_INPUT = true;
}

PARSER_BEGIN(BrailleParser)
package com.Lenguajes2.braillector;

import java.io.*;

public class BrailleParser {
    private StringBuilder salida = new StringBuilder();

    public String getSalidaBraille() {
        return salida.toString();
    }

    // --- Funciones auxiliares ---
    private String mapearBraille(String letra) {
        switch (letra.toLowerCase()) {
            case "a": return "⠁";
            case "b": return "⠃";
            case "c": return "⠉";
            case "d": return "⠙";
            case "e": return "⠑";
            case "f": return "⠋";
            case "g": return "⠛";
            case "h": return "⠓";
            case "i": return "⠊";
            case "j": return "⠚";
            case "k": return "⠅";
            case "l": return "⠇";
            case "m": return "⠍";
            case "n": return "⠝";
            case "ñ": return "⠻";
            case "o": return "⠕";
            case "p": return "⠏";
            case "q": return "⠟";
            case "r": return "⠗";
            case "s": return "⠎";
            case "t": return "⠞";
            case "u": return "⠥";
            case "v": return "⠧";
            case "w": return "⠺";
            case "x": return "⠭";
            case "y": return "⠽";
            case "z": return "⠵";

            // Vocales acentuadas y especiales según la CBE
            case "á": return "⠷";
            case "é": return "⠮";
            case "í": return "⠌";
            case "ó": return "⠬";
            case "ú": return "⠾";
            case "ü": return "⠼";
            default: return "?";
        }
    }

    private String prefijoMayuscula() {
        return "⠄"; // Estándar CBE
    }

    private String prefijoNumero() {
        return "⠼"; // Indicador numérico global
    }

    private String mapearBrailleDigito(String d) {
        char digito = d.charAt(0);
        if (digito == '0') {
            return mapearBraille("j");
        }
        return mapearBraille("" + (char)('a' + (digito - '1')));
    }

    private String mapearBrailleSigno(String s) {
        switch (s) {
            case ".": return "⠲";
            case ",": return "⠂";
            case ";": return "⠆";
            case ":": return "⠒";
            case "!": case "¡": return "⠖";
            case "?": case "¿": return "⠢";
            case "(": case ")": return "⠣";
            case "+": return "⠬";
            case "-": return "⠤";
            case "*": return "⠡";
            case "/": return "⠌";
            case "=": return "⠶";
            default: return "?";
        }
    }
}
PARSER_END(BrailleParser)

// --- Reglas léxicas (Tokens) ---
SKIP : {
    " " | "\t" | "\n" | "\r"
}

TOKEN : {
    < LETRA : ["a"-"z", "á", "é", "í", "ó", "ú", "ü", "ñ"] >
  | < MAYUSCULA : ["A"-"Z", "Á", "É", "Í", "Ó", "Ú", "Ü", "Ñ"] >
  | < DIGITO : ["0"-"9"] >
  | < SIGNO : ["+", "-", "/", "=", ".", ",", ";", ":", "¿", "?", "¡", "!", "(", ")", "\""] >
  | < INVALIDO : ~[] >
}

// --- Reglas sintácticas con acciones semánticas ---
String traducir() :
{
    Token t;
    StringBuilder resultado = new StringBuilder();
    String subNum = "";
}
{
    (
        // Si detectamos un bloque de dígitos seguido de letras (incluso con espacios intermedios), lanzamos error
        LOOKAHEAD( (<DIGITO>)+ (<LETRA>|<MAYUSCULA>) )
        t = <DIGITO> {
            throw new ParseException(" : No se pueden mezclar números y letras.");
        }
        // Si detectamos letras seguidas de dígitos (incluso con espacios intermedios), lanzamos error
      | LOOKAHEAD( (<LETRA>|<MAYUSCULA>)+ <DIGITO> )
        (t = <LETRA> | t = <MAYUSCULA>) {
            throw new ParseException(" : No se pueden mezclar letras y números.");
        }
      | t = <LETRA> { resultado.append(mapearBraille(t.image)); }
      | t = <MAYUSCULA> { resultado.append(prefijoMayuscula() + mapearBraille(t.image)); }
      | { subNum = ""; }
        t = <DIGITO> { subNum += mapearBrailleDigito(t.image); }
        (
            t = <DIGITO> { subNum += mapearBrailleDigito(t.image); }
        )*
        { resultado.append(prefijoNumero() + subNum); }
      | t = <SIGNO> { resultado.append(mapearBrailleSigno(t.image)); }
      | t = <INVALIDO> { throw new ParseException(" : El símbolo '" + t.image + "' no es válido en Braille."); }
    )*
    { return resultado.toString(); }
}